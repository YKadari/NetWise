GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
NESTWISE_GEMINI_DIAGNOSTICS=0
# Local development defaults to enabled when configured; production defaults to disabled.
# Enable public Gemini only after adding shared rate limits, access controls, and provider spend limits.
# NESTWISE_ENABLE_PUBLIC_GEMINI=false
# Firebase Admin / Firestore production configuration (server-side secrets):
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON=<secret service-account JSON; never commit>
# NESTWISE_GEMINI_USER_DAILY_LIMIT=3
# NESTWISE_GEMINI_GLOBAL_DAILY_LIMIT=<set no higher than the configured Gemini model's actual free quota>
# NESTWISE_GEMINI_MAX_CONCURRENT=2
